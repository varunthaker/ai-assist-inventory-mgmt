# Supabase → Project Settings → API

# Your project's REST endpoint: https://<project-ref>.supabase.co
# Not secret — visible in any browser request.
SUPABASE_URL=

# "service_role" key (newer projects show it as sb_secret_...).
# BYPASSES Row Level Security = full database access.
# Server-side only. Never commit it, never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# "anon" key (newer projects: sb_publishable_...).
# Respects Row Level Security — safe to expose in the browser.
# Not used by the backend. Optional.
SUPABASE_ANON_KEY=

# --- Agent ---

# OpenAI API key for the LangChain agent (platform.openai.com/api-keys).
# Required only for POST /chat; /health works without it.
OPENAI_API_KEY=

# Any tool-calling model. Recommended: gpt-5.4-mini (with
# OPENAI_REASONING_EFFORT=none) -- follows the "check policy before ordering"
# rules reliably and answers in ~3 s.
OPENAI_MODEL=gpt-4o-mini

# Leave empty for OpenAI. For Groq (key from console.groq.com/keys):
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=

# Reasoning models only. Leave empty for gpt-4o-mini / gpt-4.1-mini.
# - gpt-5.x on OpenAI: use "none" -- OpenAI rejects tools + reasoning on the
#   chat completions API this app uses ("Function tools with reasoning_effort
#   are not supported").
# - gpt-oss-20b on Groq: use "low" -- at the default, multi-tool questions often
#   fail with "output_parse_failed" or an empty reply.
OPENAI_REASONING_EFFORT=

# --- Embeddings (RAG: PDF upload + policy search) ---

# OpenAI key used ONLY for embeddings. Separate from OPENAI_API_KEY above,
# which may be a Groq key -- Groq has no embeddings endpoint.
EMBEDDING_API_KEY=

# Must match vector(N) in sql/sop_documents.sql. Changing the model means
# re-running that SQL on an empty table and re-uploading every PDF.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Frontend ---

# Browser origins allowed to call the API, comma-separated. Default is the
# Vite dev server (React): http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# --- MCP ---

# The MCP server is mounted in this app at /mcp. Change this only if you run
# uvicorn on a different host/port, or use a remote MCP server.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Public hostnames allowed to reach /mcp, comma-separated, no scheme or path.
# Needed when exposing the server through ngrok, otherwise requests get 421.
# e.g. MCP_ALLOWED_HOSTS=abcd-1234.ngrok-free.app
MCP_ALLOWED_HOSTS=
